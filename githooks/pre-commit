#!/usr/bin/env bash
# pre-commit: scan staged changes for secrets with gitleaks.
# Bypass (emergency only): git commit --no-verify
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "WARNING: gitleaks not found, secret scan SKIPPED. Run: brew install gitleaks" >&2
  exit 0
fi
if ! gitleaks git --staged --redact --verbose; then
  echo >&2
  echo "Commit blocked: possible secret in staged changes." >&2
  echo "Remove it (and rotate it if it was ever real), then commit again." >&2
  exit 1
fi
